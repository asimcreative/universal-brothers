APP_NAME="Universal Brothers"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8129

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Dedicated Playwright/E2E database — never the dev database, never production.
# Playwright drives a real running server, so unlike PHPUnit (which uses an
# in-memory SQLite via phpunit.xml) its writes have to land somewhere real.
# They land here.
DB_CONNECTION=sqlite
DB_DATABASE=database/testing.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@maximsgroup.org"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# Copy this file to `.env.testing`, then run:
#     php artisan key:generate --env=testing
#     touch database/testing.sqlite
#     php artisan migrate:fresh --seed --env=testing
#
# Playwright's webServer boots with `--env=testing` (see playwright.config.js),
# so every browser-driven test writes here and never to the development or
# production database.
# ---------------------------------------------------------------------
